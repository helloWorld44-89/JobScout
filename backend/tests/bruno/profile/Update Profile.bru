meta {
  name: Update Profile
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/v1/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "notification_email": "newemail@example.com",
    "skills": ["Python", "FastAPI", "PostgreSQL", "Docker", "React", "TypeScript"]
  }
}
