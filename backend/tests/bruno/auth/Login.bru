meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{appUsername}}
  password: {{appPassword}}
}

script:post-response {
  const data = res.getBody();
  if (data && data.access_token) {
    bru.setVar("accessToken", data.access_token);
  }
}
