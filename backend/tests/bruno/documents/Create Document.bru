meta {
  name: Create Document
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/documents
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "job_id": {{jobId}},
    "type": "cover_letter",
    "content": "Dear Hiring Manager, I am excited to apply for..."
  }
}
