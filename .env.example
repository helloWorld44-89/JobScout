# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=jobscout
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobscout

# Used for local dev (outside Docker). Docker Compose overrides this automatically.
DATABASE_URL=postgresql+asyncpg://jobscout:changeme@localhost:5432/jobscout

# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=changeme-replace-with-a-long-random-string

# ── Auth ──────────────────────────────────────────────────────────────────────
APP_USERNAME=admin
# Generate hash: uv run python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('yourpassword'))"
APP_PASSWORD_HASH=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI / LiteLLM (Phase 3) ───────────────────────────────────────────────────
# Model string passed directly to LiteLLM — change this to switch providers.
# Examples:
#   OpenAI:    gpt-4o-mini
#   Anthropic: claude-sonnet-4-6
#   Gemini:    gemini/gemini-2.0-flash
#   Ollama:    ollama/llama3.2
AI_MODEL=gpt-4o-mini

# Only required when using Ollama. Point to wherever Ollama is running.
#   Docker Compose profile:  http://ollama:11434
#   Local machine:           http://localhost:11434
#   Remote host:             http://192.168.1.x:11434
AI_BASE_URL=

# Provider API keys — only the key matching your chosen AI_MODEL is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── SMTP / Email (Phase 4) ────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Scoring ───────────────────────────────────────────────────────────────────
SCORE_THRESHOLD=70
